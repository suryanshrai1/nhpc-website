model audit_logs {
  id          BigInt   @id(map: "pk_audit_logs") @default(autoincrement())
  admin_id    BigInt
  action      String   @db.VarChar(50)
  entity_type String   @db.VarChar(100)
  entity_id   BigInt
  old_data    Json?
  new_data    Json?
  ip_address  String?  @db.Inet
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  admins      admins   @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_logs_admin")

  @@index([action], map: "idx_audit_logs_action")
  @@index([admin_id], map: "idx_audit_logs_admin")
  @@index([admin_id, created_at(sort: Desc)], map: "idx_audit_logs_admin_created")
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([ip_address], map: "idx_audit_logs_ip")
}

