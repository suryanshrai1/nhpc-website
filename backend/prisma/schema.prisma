generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admins {
  id                       BigInt        @id(map: "pk_admins") @default(autoincrement())
  full_name                String        @db.VarChar(150)
  email                    String        @unique(map: "uq_admins_email") @db.VarChar(255)
  password_hash            String
  role                     String        @db.VarChar(50)
  last_login_at            DateTime?     @db.Timestamptz(6)
  is_active                Boolean       @default(true)
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime      @default(now()) @db.Timestamptz(6)
  refresh_token_hash       String?
  last_password_changed_at DateTime?     @db.Timestamptz(6)
  audit_logs               audit_logs[]
  media_files              media_files[]

  @@index([email], map: "idx_admins_email")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model application_statuses {
  id               BigInt             @id(map: "pk_application_statuses") @default(autoincrement())
  name             String             @unique(map: "uq_application_statuses_name") @db.VarChar(100)
  code             String             @unique(map: "uq_application_statuses_code") @db.VarChar(30)
  description      String?
  display_order    Int                @default(1)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  job_applications job_applications[]

  @@index([code], map: "idx_application_statuses_code")
  @@index([name], map: "idx_application_statuses_name")
}

